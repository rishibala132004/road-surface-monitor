{
  "name": "road-surface-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Live dashboard for a bicycle-mounted road surface classifier (University of Twente IoT course project)",
  "type": "module",
  "license": "MIT",
  "author": "Rishi Bala S, Adarsh Nanjaiya Latha and team",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "make-route": "node tools/make-route.mjs",
    "make-demo": "node tools/make-demo-ride.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
